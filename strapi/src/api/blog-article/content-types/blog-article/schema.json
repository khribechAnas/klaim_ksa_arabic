{
  "kind": "collectionType",
  "collectionName": "blog_articles",
  "info": {
    "singularName": "blog-article",
    "pluralName": "blog-articles",
    "displayName": "Blog Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "publishedOn": {
      "type": "datetime",
      "required": true
    },
    "admin_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "admin::user"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "maxLength": 200
    },
    "blog_tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-tag.blog-tag"
    }
  }
}
